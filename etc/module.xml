<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="OOCS_LynxReCaptcha">
        <sequence>
            <!-- The store config this module adds its section to. -->
            <module name="OOCS_LynxTheme"/>
            <!-- Storefront reCAPTCHA settings and the resolvers that read them;
                 validation stays with core's predispatch observers. -->
            <module name="Magento_ReCaptchaFrontendUi"/>
        </sequence>
    </module>
</config>
